# Local env for fj release / signing / notarization.
#
# This file is checked in for documentation. Make a real `.env` (or
# `.env.local`) alongside it with actual values, then `source .env` before
# running the release scripts. `.env*` is gitignored except for this file.
#
# Sensitive values (Apple ID app-specific passwords, notary API keys) must
# NOT live here. Store them in the macOS keychain instead:
#
#   xcrun notarytool store-credentials fj-notary \
#     --apple-id <your-apple-id> \
#     --team-id 62Y3FRM8PD \
#     --password <app-specific-password>
#
# The release scripts reference the resulting keychain profile by name.

# Apple developer identity used by codesign. Public (every signed binary
# embeds it), but keeping it here lets release scripts swap identities
# without code changes.
FJ_APPLE_TEAM_ID=62Y3FRM8PD
FJ_APPLE_DEVELOPER_ID="Developer ID Application: Raster & State LLC (62Y3FRM8PD)"

# Name of the keychain profile created by `xcrun notarytool store-credentials`.
# The notarize step looks this up; if it doesn't exist, skip notarization.
FJ_NOTARY_PROFILE=fj-notary

# Forgejo host the release scripts target.
FJ_RELEASE_HOST=rasterhub.com

# Test repo used by scripts/e2e-smoke.sh and the release smoke check.
FJ_E2E_REPO=stephen/fj-cli-test
